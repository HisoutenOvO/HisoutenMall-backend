<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.hisouten.mall.mapper.BrandMapper">
    <select id="pageQuery" resultType="cn.hisouten.mall.pojo.bo.brand.BrandPageResultBO">
        select * from brand
        <where>
            <if test="dto.getKeyword() != null and dto.getKeyword() != ''">
                and name like concat('%', #{dto.keyword}, '%')
            </if>
            <if test="dto.status != null">
                and status = #{dto.status}
            </if>
            <if test="dto.deleted != null">
                and deleted = #{dto.deleted}
            </if>
        </where>
    </select>
</mapper>