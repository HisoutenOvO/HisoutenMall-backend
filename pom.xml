<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>cn.hisouten.mall</groupId>
    <artifactId>HisoutenMall</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>HisoutenMall-framework</module>
        <module>HisoutenMall-module-account</module>
        <module>HisoutenMall-module-product</module>
        <module>HisoutenMall-module-trade</module>
        <module>HisoutenMall-module-marketing</module>
        <module>HisoutenMall-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <knife4j.version>4.4.0</knife4j.version>
        <hutool.version>5.8.25</hutool.version>
    </properties>

    <!-- 全局通用依赖，所有子模块继承 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 项目内部模块版本管理 -->
    <dependencyManagement>
        <dependencies>
            <!-- 项目内部模块 -->
            <dependency>
                <groupId>cn.hisouten.mall</groupId>
                <artifactId>HisoutenMall-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hisouten.mall</groupId>
                <artifactId>HisoutenMall-module-account</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hisouten.mall</groupId>
                <artifactId>HisoutenMall-module-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hisouten.mall</groupId>
                <artifactId>HisoutenMall-module-trade</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hisouten.mall</groupId>
                <artifactId>HisoutenMall-module-marketing</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方依赖 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>